{
  "name": "xr-mobile-object-sandbox-webxr",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "WebXR port of XRMobileObjectSandbox: UWB/IMU telemetry, WebSocket bridge, Three.js scene, profiles, dashboard, LLM and actuation abstractions.",
  "scripts": {
    "dev": "concurrently -k \"npm:backend\" \"npm:web\"",
    "web": "vite --host 0.0.0.0",
    "web:https": "HTTPS=1 vite --host 0.0.0.0",
    "backend": "node backend/server.js",
    "sim:udp": "node backend/telemetry-simulator.js",
    "build": "tsc && vite build",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@vitejs/plugin-basic-ssl": "^2.0.0",
    "concurrently": "^9.1.2",
    "three": "^0.178.0",
    "vite": "^7.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.0",
    "typescript": "^5.8.0"
  }
}
